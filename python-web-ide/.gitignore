# 日志文件：构建或工具执行产生的临时日志不应进入版本控制。
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 依赖目录：可由 package-lock.json 还原，禁止提交。
node_modules
dist
dist-ssr
*.local

# Python 解释器可按需重新生成的字节码缓存，不属于示例工作区源代码。
__pycache__/
*.py[cod]

# 编辑器目录和临时文件：属于个人环境，不属于项目源代码。
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
