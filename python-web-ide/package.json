{
  "name": "python-web-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.{mjs,json}\" \"docs/**/*.md\" \"*.md\" \"*.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.{mjs,json}\" \"docs/**/*.md\" \"*.md\" \"*.html\""
  },
  "dependencies": {
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
